{
  "permissions": {
    "allow": [
      "Bash(lilsound)",
      "Bash(lilsound:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "comment": [
              "Finish sound, skip while a barn-claude-jarvis mode is on"
            ],
            "command": "[ -f ~/.cache/barn-claude-jarvis/mode ] || lilsound $$",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "comment": [
      "Prints directory, git branch, model, effort and context usage",
      "below the prompt."
    ],
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "atlassian-twg-cli@claude-plugins-official": true,
    "grug@mapbox-claude-plugins": true,
    "mbx-dev@mapbox-claude-plugins": true,
    "prep@mapbox-claude-plugins": true,
    "simplified-spec-kit@mapbox-claude-plugins": true,
    "barn-claude-jarvis@barn-claude-jarvis": true
  },
  "extraKnownMarketplaces": {
    "mapbox-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "mapbox/claude-plugins"
      }
    },
    "barn-claude-jarvis": {
      "source": {
        "source": "directory",
        "path": "/Users/andreasl/Dev/barn-claude-jarvis"
      }
    }
  },
  "effortLevel": "high",
  "theme": "dark-daltonized"
}
