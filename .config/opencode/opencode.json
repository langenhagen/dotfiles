{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "opencode/big-pickle",
  "agent": {
    "plan": { "color": "#90EE90" },
    "build": { "color": "#E85D3A" }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.8:27b-mlx": {
          "tools": true,
          "limit": { "context": 65536, "output": 8192 }
        },
        "qwen3.5:9b": {
          "tools": true,
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    }
  }
}
